---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={["theme-toggle btn btn-ghost btn-sm btn-circle", className]}
  aria-label="Toggle light and dark theme"
  title="Toggle light and dark theme"
>
  <svg
    class="theme-icon-sun h-5 w-5"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg
    class="theme-icon-moon h-5 w-5"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style is:global>
  .theme-icon-moon {
    display: none;
  }
  [data-theme="slrosales-dark"] .theme-icon-sun {
    display: none;
  }
  [data-theme="slrosales-dark"] .theme-icon-moon {
    display: block;
  }
</style>
