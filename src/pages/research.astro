---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Research & Publications" sideBarActiveItemID="research">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Research & Publications</div>
  </div>

  <p class="mb-6 text-lg opacity-80">
    Published research and technical reports from my academic and R&D work.
  </p>

  <HorizontalCard
    title="Automatic Transcription & Contextualization System"
    desc="Open-source web application that automatically transcribes class audio and contextualizes it to generate structured, referenced study guides. Uses a fine-tuned Vosk (Kaldi) ASR model and ChromaDB vector search."
    url="http://hdl.handle.net/10584/13381"
    badge="Publication"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Huesitos — Medical Image Analysis & AI"
    desc="Machine-learning study applying Convolutional Neural Networks to fracture detection in X-rays, with the creation of the 'Huesitos' dataset and comparison of feature extraction methods against deep learning."
    url="https://github.com/Slrosales/Huesitos/blob/main/Informe%20de%20Semillero%20de%20Investigación.pdf"
    badge="Report"
  />
</BaseLayout>
