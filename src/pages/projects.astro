---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects</div>
  </div>

  <HorizontalCard
    title="Transcription & Contextualization System"
    img="/post_img.webp"
    desc="Open-source web application that converts audio recordings into Markdown study guides, integrating a fine-tuned Vosk ASR model with contextual vector search via ChromaDB. Built with Python, Vosk, ChromaDB, and JavaScript."
    url="https://github.com/slrosales"
    badge="Capstone"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Rubik's Race — Heuristic Solving"
    img="/post_img.webp"
    desc="Web application that solves Rubik's Race using the A* algorithm with a custom heuristic combining Manhattan distance and a bonus term for completed rows. Built with Python."
    url="https://github.com/slrosales"
    badge="Search"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Huesitos — Medical Image Analysis & AI"
    img="/post_img.webp"
    desc="CNN-based fracture detection on X-rays with a confidence threshold, built on an annotated dataset of 600+ images. Compares feature extraction methods (HOG, Haralick, Otsu) against deep learning. Built with Python, TensorFlow, Scikit-learn, OpenCV."
    url="https://github.com/slrosales"
    badge="AI/ML"
  />
</BaseLayout>
