---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { Image } from "astro:assets";
import tutorly from "../assets/projects/tutorly.webp";
import huesitos from "../assets/projects/huesitos.webp";
import rubik from "../assets/projects/rubik.webp";
import gScop from "../assets/projects/g_scop.webp";
---

<BaseLayout title="Research & Development" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Research & Development</div>
  </div>

  <HorizontalCard
    title="SusInnoS Platform"
    img={gScop}
    desc="Developed core modules for the SusInnoS platform (G-SCOP / CNRS) to automate Life Cycle Assessment: an AI semantic search engine (Sentence-BERT, FAISS, Cross-Encoder) mapping Bills of Materials to Ecoinvent, an LCA calculation engine with Brightway, and Hugging Face model benchmarking. Built with Python, Django, PostgreSQL, SQLite, Docker, and Git."
    url="https://www.susinnos.fr"
    badge="R&D"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Transcription & Contextualization System"
    img={tutorly}
    desc="Open-source web application that automatically transcribes class audio and contextualizes it into structured, referenced study guides exportable in Markdown. Uses a Vosk (Kaldi) ASR model fine-tuned for Latin American Spanish, enriched with student notes and open-access resources. Built with Python, ChromaDB, and JavaScript."
    url="http://hdl.handle.net/10584/13381"
    badge="Research"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Huesitos — Medical Image Analysis & AI"
    img={huesitos}
    desc="Machine-learning system for fracture detection in X-rays using Convolutional Neural Networks, classifying images as fractured, non-fractured, or unidentified below a 25% confidence threshold. Built on the 'Huesitos' dataset (326 fracture + 300 non-fracture images) and compared HOG, Otsu, Haralick, and gradient features against deep learning."
    url="https://github.com/Slrosales/Huesitos/blob/main/Informe%20de%20Semillero%20de%20Investigación.pdf"
    badge="Research"
  />
  <div class="divider my-0"></div>
  <div class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%] p-5">
    <div class="aspect-[16/9] w-full overflow-hidden rounded-lg mb-4">
      <Image
        src={rubik}
        width={1600}
        height={900}
        format="webp"
        alt="Rubik's Race"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="flex items-center gap-2">
      <h1 class="text-xl font-bold">Rubik's Race — Heuristic Solving</h1>
      <div class="badge badge-secondary">Project</div>
    </div>
    <p class="py-1">
      Web application that solves the Rubik's Race puzzle using the A* algorithm with a heuristic
      based on Manhattan distance. My repository focuses on the A* solver (the math part), while
      the frontend lives in a separate repository.
    </p>
    <div class="flex flex-wrap gap-2 mt-2">
      <a class="btn btn-sm btn-primary" href="https://rubik-race.vercel.app" target="_blank">Live Demo</a>
      <a class="btn btn-sm btn-outline" href="https://github.com/JuandiGo1/Rubik-race" target="_blank">Frontend Repo</a>
      <a class="btn btn-sm btn-outline" href="https://github.com/Slrosales/Rubik_Race_Heuristic_solution" target="_blank">Solver Repo</a>
    </div>
  </div>
</BaseLayout>
